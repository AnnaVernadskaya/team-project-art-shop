{
  "name": "team-project-art-shop",
  "version": "1.0.0",
  "description": "Учебный командный проект RS School — интернет-магазин картин. В приложении можно просматривать каталог, добавлять картины в корзину, удалять их и видеть общую стоимость заказа.",
  "main": "index.js",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnnaVernadskaya/team-project-art-shop.git"
  },
