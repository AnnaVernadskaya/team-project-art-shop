  "bugs": {
    "url": "https://github.com/AnnaVernadskaya/team-project-art-shop/issues"
  },
  "homepage": "https://github.com/AnnaVernadskaya/team-project-art-shop#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "3.10.1",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
